  "query_dsl": {
    "parameter": "q",
    "operators": [
      "EQ(field,value)",
      "NEQ(field,value)",
      "GT(field,value)",
      "GTE(field,value)",
      "LT(field,value)",
      "LTE(field,value)",
      "LIKE(field,pattern)",
      "IN(field,v1|v2|v3)",
      "NOT-IN(field,v1|v2)"
    ],
    "projection": "keys=field1,field2 (use * for all fields)",
    "pagination": "limit-offset: ?limit=N&offset=M",
    "expansion": "expand=field1,field2 on list and get-by-id routes replaces those reference fields (each entity's relationships) with the referenced documents"
  },
  "representations": {
    "parameter": "format",
    "values": [
      "json",
      "xml",
      "yaml",
      "pdf"
    ],
    "default": "json",
    "accept": {
      "json": [
        "application/json"
      ],
      "xml": [
        "application/xml",
        "text/xml"
      ],
      "yaml": [
        "application/yaml",
        "application/x-yaml",
        "text/yaml"
      ],
      "pdf": [
        "application/pdf"
      ]
    },
    "precedence": "?format= overrides the Accept header; browsers (Accept with text/html) get json",
    "applies_to": "every JSON response, errors included"
  }
}